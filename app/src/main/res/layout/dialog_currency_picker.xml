<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
      Search field. 46 currencies were previously browsable only by repeated swiping, and the
      active selection could sit off-screen with no visible tick.
    -->
    <EditText
        android:id="@+id/et_currency_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:hint="@string/currency_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <!--
      ListView and the "no results" view must share a parent for setEmptyView to toggle them.
      Height is bounded at runtime (see showCurrencyDialog) so the dialog cannot grow past the
      screen in landscape.
    -->
    <FrameLayout
        android:id="@+id/fl_currency_list"
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <ListView
            android:id="@+id/lv_currencies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice" />

        <TextView
            android:id="@+id/tv_currency_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/currency_no_results"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
