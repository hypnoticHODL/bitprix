<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
          The API cache is fully regenerable and dominated by the 365-day chart series
          (~38 KB of JSON). Backing it up wastes bandwidth on restore for data that is
          refetched within minutes, so it is excluded.
        -->
        <exclude domain="sharedpref" path="bitcoin_widget_cache.xml" />
        <exclude domain="file" path="cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bitcoin_widget_cache.xml" />
    </device-transfer>
</data-extraction-rules>
