<?xml version="1.0" encoding="utf-8"?>
<!--
   Rules for Android 11 and below (see data_extraction_rules.xml for API 31+).
   The API cache is regenerable and is deliberately not backed up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="bitcoin_widget_cache.xml" />
    <exclude domain="file" path="cache" />
</full-backup-content>
